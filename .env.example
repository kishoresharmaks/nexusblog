# ==========================================
# NexusBlog Monorepo Environment Variables
# ==========================================

# Database Connection (MongoDB)
DATABASE_URL="mongodb://localhost:27017/nexusblog?authSource=admin"

# Custom Auth & JWT Configuration
JWT_ACCESS_SECRET="nexus-access-secret-super-secure-change-in-production-12345"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="nexus-refresh-secret-super-secure-change-in-production-67890"
JWT_REFRESH_EXPIRES_IN="7d"

# Server Ports & URLs
PORT=4000
API_PORT=4000
CLIENT_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# Storage Provider (local | r2)
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR="../../storage/local/media"

# Cloudflare R2 / S3 Configuration (Optional for production)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="nexusblog-media"
R2_PUBLIC_URL="https://media.nexusnation.in"
